{
  "expo": {
    "name": "Mesh Help",
    "slug": "mesh-help",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "org.meshhelp.demo",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Connect with nearby people and the offline hub over Bluetooth.",
        "NSBluetoothPeripheralUsageDescription": "Bluetooth lets nearby mesh peers find and message you.",
        "UIBackgroundModes": [
          "bluetooth-central",
          "bluetooth-peripheral"
        ],
        "NSLocationWhenInUseUsageDescription": "Show your position offline. Share it only when you choose."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "org.meshhelp.demo",
      "permissions": [
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_ADVERTISE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "mesh-help",
    "plugins": [
      "@maplibre/maplibre-react-native",
      "./modules/bitchat-mesh/app.plugin.js",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Show your position offline. Share it only when you choose."
        }
      ],
      [
        "expo-file-system",
        {
          "enableFileSharing": true,
          "supportsOpeningDocumentsInPlace": true
        }
      ]
    ],
    "backgroundColor": "#000000"
  }
}
